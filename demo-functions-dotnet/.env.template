# Agent ID .NET Functions Demo -- Environment Configuration Template
#
# Run the scripts in order and they will populate .env progressively.
# Prerequisites script (../demo/persona-1-governance/00-setup-prerequisites.sh) must
# have been run first to create MGMT_APP_ID, MGMT_APP_SECRET, SPONSOR_GROUP_ID.
#
#   01-provision-function.sh  → Function App (.NET 8), MI config
#   02-add-fic-for-msi.sh    → FIC on existing blueprint
#   03-create-agent-id.sh     → Agent identity IDs (Persona 1)
#   04-setup-storage.sh      → Storage account
#   05-deploy-function.sh    → (read-only)
#   06-verify.sh             → (read-only)

# --- Prerequisites (from AKS demo or 00-setup-prerequisites.sh) ---
MGMT_APP_ID=
MGMT_APP_SECRET=
SPONSOR_GROUP_ID=

# --- Existing blueprint (from AKS demo's .env) ---
TENANT_ID=
BLUEPRINT_OBJECT_ID=
BLUEPRINT_APP_ID=

# ============================================================
# AUTO-POPULATED: Scripts write these values as they run
# ============================================================

# --- Function App config (written by 01-provision-function.sh) ---
FUNC_RESOURCE_GROUP=rg-agentid-func-dotnet
FUNC_APP_NAME=func-agentid-dotnet
FUNC_STORAGE_NAME=
FUNC_LOCATION=centralus
MI_NAME=mi-agentid-func-dotnet
MI_CLIENT_ID=
MI_PRINCIPAL_ID=

# --- Agent Identity config (written by persona-1-governance/03-create-agent-id.sh) ---
AGENT_IDENTITY_ID=
AGENT_IDENTITY_OBJECT_ID=
AGENT_DISPLAY_NAME=agentid-func-dotnet-agent-01

# --- Storage config (written by 04-setup-storage.sh) ---
STORAGE_ACCOUNT_NAME=
STORAGE_CONTAINER=agent-demo
