# Agent ID Demo -- Environment Configuration Template
#
# You do NOT need to edit this file manually.
# Run the scripts in order and they will populate .env progressively:
#   00-setup-prerequisites.sh → MGMT_APP_ID, MGMT_APP_SECRET, SPONSOR_GROUP_ID
#   01-provision-aks.sh       → AKS config, ACR
#   02-create-blueprint.sh    → Blueprint IDs
#   03-create-agent-id.sh     → Agent identity IDs (Persona 1)
#   04-setup-resources.sh     → Storage account
#
# To start fresh: cp .env.template .env && bash persona-1-governance/00-setup-prerequisites.sh

# --- Prerequisites (written by 00-setup-prerequisites.sh) ---
MGMT_APP_ID=
MGMT_APP_SECRET=
SPONSOR_GROUP_ID=

# ============================================================
# AUTO-POPULATED: Scripts write these values as they run
# ============================================================

# --- AKS + infrastructure config (written by 01-provision-aks.sh) ---
RESOURCE_GROUP=rg-agentid-demo
CLUSTER_NAME=aks-agentid-demo
LOCATION=centralus
OIDC_ISSUER_URL=
K8S_NAMESPACE=agent-demo
K8S_SA_NAME=agent-sa
ACR_NAME=

# --- Blueprint config (written by 02-create-blueprint.sh) ---
TENANT_ID=
BLUEPRINT_OBJECT_ID=
BLUEPRINT_APP_ID=
BLUEPRINT_SP_ID=

# --- Agent Identity config (written by persona-1-governance/03-create-agent-id.sh) ---
AGENT_IDENTITY_ID=
AGENT_IDENTITY_OBJECT_ID=
AGENT_DISPLAY_NAME=agentid-demo-agent-01

# --- Storage config (written by 04-setup-resources.sh) ---
STORAGE_ACCOUNT_NAME=
STORAGE_CONTAINER=agent-demo
