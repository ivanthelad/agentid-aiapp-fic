# Agent ID Functions Demo -- Environment Configuration Template
#
# Run the scripts in order and they will populate .env progressively.
# This demo is self-contained -- no other demos need to be run first.
#
#   00-setup-prerequisites.sh → Management app, sponsor group
#   01-provision-function.sh  → Function App, MI config
#   02-create-blueprint.sh    → Blueprint + MSI FIC
#   03-create-agent-id.sh     → Agent identity IDs (Persona 1)
#   04-setup-storage.sh       → Storage account
#   05-deploy-function.sh     → (read-only)
#   06-verify.sh              → (read-only)
#   07-publish-a365.sh        → Publish to Microsoft 365 admin center

# --- Prerequisites (created by 00-setup-prerequisites.sh) ---
MGMT_APP_ID=
MGMT_APP_SECRET=
SPONSOR_GROUP_ID=

# --- Blueprint config (created by 02-create-blueprint.sh) ---
TENANT_ID=
BLUEPRINT_OBJECT_ID=
BLUEPRINT_APP_ID=
BLUEPRINT_SP_ID=

# ============================================================
# AUTO-POPULATED: Scripts write these values as they run
# ============================================================

# --- Function App config (written by 01-provision-function.sh) ---
FUNC_RESOURCE_GROUP=rg-agentid-func-demo
FUNC_APP_NAME=func-agentid-demo
FUNC_STORAGE_NAME=
FUNC_LOCATION=centralus
MI_NAME=mi-agentid-func
MI_CLIENT_ID=
MI_PRINCIPAL_ID=

# --- Agent Identity config (written by persona-1-governance/03-create-agent-id.sh) ---
AGENT_IDENTITY_ID=
AGENT_IDENTITY_OBJECT_ID=
AGENT_DISPLAY_NAME=agentid-func-agent-01

# --- Storage config (written by 04-setup-storage.sh) ---
STORAGE_ACCOUNT_NAME=
STORAGE_CONTAINER=agent-demo

# --- Agent 365 Publishing (required by 07-publish-a365.sh) ---
A365_CLIENT_APP_ID=
SUBSCRIPTION_ID=
MANAGER_EMAIL=
